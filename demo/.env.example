# Copy to .env and edit (at least the passwords) before `docker compose up`.
# Port the site is published on (the host side).
HTTP_PORT=8080

# Joomla site + Super User (you share these privately with reviewers).
SITE_NAME=Customize Mode Demo
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-please
ADMIN_EMAIL=admin@example.com

# Database credentials (kept inside the compose network).
DB_NAME=joomla
DB_USER=joomla
DB_PASSWORD=change-this-db-password
DB_ROOT_PASSWORD=change-this-root-password

# Source to build from (defaults to the public fork branch).
REPO=https://github.com/hikashop-nicolas/joomla-cms.git
BRANCH=feature/customize-mode
